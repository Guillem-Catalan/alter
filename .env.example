# Copy to .env and fill in. Never commit .env.

# --- Assistant ---
BOT_NAME=Alter
# Language of the bot's own messages (en or es). It always chats in the language you write in.
BOT_LANGUAGE=en
# Where your profile, chats, files and the voice model are stored. Default, outside this repo:
# macOS ~/Library/Application Support/Alter · Linux ~/.local/share/alter · Windows %APPDATA%\Alter
DATA_DIR=
# Extra skill folders, separated by ":" (each holds folders with a SKILL.md)
EXTRA_SKILLS_DIRS=
# Clean drafts of em dashes, invisible characters and stock AI words (default: true)
HUMANIZE=true

# --- Model ---
# anthropic (default) | azure (Anthropic-compatible endpoint) | openai (any OpenAI-compatible API)
LLM_PROVIDER=anthropic
# Default: claude-opus-5-5 for anthropic, AZURE_CLAUDE_DEPLOYMENT for azure. Required for openai.
LLM_MODEL=
# Optional: low | medium | high | xhigh | max
LLM_EFFORT=
# Retry on another Claude model if a request is declined (Anthropic API only, default: true)
LLM_FALLBACKS=true

ANTHROPIC_API_KEY=

AZURE_CLAUDE_ENDPOINT=
AZURE_CLAUDE_API_KEY=
AZURE_CLAUDE_DEPLOYMENT=

# OpenAI, OpenRouter (https://openrouter.ai/api/v1), Ollama (http://localhost:11434/v1), Gemini...
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# --- Voice notes (whisper.cpp, runs locally) ---
WHISPER_BIN=whisper-cli
# Default: <data folder>/models/ggml-large-v3-turbo-q5_0.bin (scripts/download-whisper-model.sh)
WHISPER_MODEL=
# auto, es, en...
WHISPER_LANGUAGE=auto
FFMPEG_BIN=ffmpeg

# --- WhatsApp (Meta WhatsApp Cloud API) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
# Any random string; the same one goes in Meta's webhook settings
WHATSAPP_VERIFY_TOKEN=
# Only these numbers get answers (international format, comma-separated)
WHATSAPP_ALLOWED_NUMBERS=
WHATSAPP_API_VERSION=v25.0
PORT=8080
# Your fixed ngrok domain (used by scripts/install-macos.sh)
NGROK_DOMAIN=

# --- Slack (optional, off by default) ---
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
